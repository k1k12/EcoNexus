# Copy this file to backend/.env and fill it in. Never commit the real .env.

PYTHONPATH=./src
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/econexus
TEST_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/test

# Make your own with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:8081,http://localhost:5087

# Only needed to download real council boundaries with getcouncils.py
ESD_API_KEY=
